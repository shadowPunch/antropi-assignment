<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>

  <world name="default">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
  <xacro:unless value="$(arg headless)">
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
  </xacro:unless>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <light name='sun' type='directional'>
        <cast_shadows>0</cast_shadows>
        <pose>0 0 10 0 0 0</pose>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.8 0.8 0.8 1</specular>
        <attenuation>
            <range>1000</range>
            <constant>0.9</constant>
            <linear>0.01</linear>
            <quadratic>0.001</quadratic>
        </attenuation>
        <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name='ground_plane'>
        <static>1</static>
        <link name='link'>
            <collision name='collision'>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>100 100</size>
                    </plane>
                </geometry>
                <max_contacts>10</max_contacts>
            </collision>
            <visual name='visual'>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>100 100</size>
                    </plane>
                </geometry>
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>
        </link>
    </model>

    <scene>
      <shadows>0</shadows>
    </scene>

    <physics name='3ms' type='ode'>
        <max_step_size>0.003</max_step_size>
        <real_time_factor>1</real_time_factor>
    </physics>

    <!-- Obstacle course: 9 x 6 m room. Spawn is (-2.0, -0.5), the stock default.
         Two offset partitions force an S-shaped route through a 1.8 m corridor;
         the east side is a cluttered area. Gaps stay >= 0.7 m (robot 0.44 m wide). -->
    <xacro:macro name="box" params="name x y yaw sx sy h:=0.6 color:='0.6 0.6 0.6 1'">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} ${h/2} 0 0 ${yaw}</pose>
        <link name="link">
          <collision name="collision"><geometry><box><size>${sx} ${sy} ${h}</size></box></geometry></collision>
          <visual name="visual">
            <geometry><box><size>${sx} ${sy} ${h}</size></box></geometry>
            <material><ambient>${color}</ambient><diffuse>${color}</diffuse></material>
          </visual>
        </link>
      </model>
    </xacro:macro>

    <xacro:macro name="cylinder" params="name x y r h:=0.6 color:='0.2 0.4 0.8 1'">
      <model name="${name}">
        <static>true</static>
        <pose>${x} ${y} ${h/2} 0 0 0</pose>
        <link name="link">
          <collision name="collision"><geometry><cylinder><radius>${r}</radius><length>${h}</length></cylinder></geometry></collision>
          <visual name="visual">
            <geometry><cylinder><radius>${r}</radius><length>${h}</length></cylinder></geometry>
            <material><ambient>${color}</ambient><diffuse>${color}</diffuse></material>
          </visual>
        </link>
      </model>
    </xacro:macro>

    <!-- Outer walls: interior x in [-4.5, 4.5], y in [-3, 3] -->
    <xacro:box name="wall_north" x="0"    y="3.1"  yaw="0" sx="9.4" sy="0.2"/>
    <xacro:box name="wall_south" x="0"    y="-3.1" yaw="0" sx="9.4" sy="0.2"/>
    <xacro:box name="wall_west"  x="-4.6" y="0"    yaw="0" sx="0.2" sy="6.0"/>
    <xacro:box name="wall_east"  x="4.6"  y="0"    yaw="0" sx="0.2" sy="6.0"/>

    <!-- Partitions: west one open at the north end, east one open at the south end -->
    <xacro:box name="partition_west" x="-1.0" y="-0.6" yaw="0" sx="0.2" sy="4.8" color="0.7 0.5 0.3 1"/>
    <xacro:box name="partition_east" x="1.0"  y="0.6"  yaw="0" sx="0.2" sy="4.8" color="0.7 0.5 0.3 1"/>

    <!-- West start area -->
    <xacro:box      name="start_box"  x="-3.3" y="1.3"  yaw="0" sx="1.0" sy="0.4"/>
    <xacro:cylinder name="start_cyl"  x="-3.0" y="-2.0" r="0.3"/>

    <!-- Corridor pillar: leaves 1.0 m on the west side, 0.4 m (blocked) on the east -->
    <xacro:cylinder name="corridor_pillar" x="0.3" y="0.3" r="0.2" color="0.8 0.2 0.2 1"/>

    <!-- East cluttered area -->
    <xacro:cylinder name="clutter_cyl_1" x="2.2" y="1.6"  r="0.2"/>
    <xacro:box      name="clutter_box_1" x="3.5" y="2.0"  yaw="0"   sx="0.6" sy="0.6"/>
    <xacro:box      name="clutter_box_2" x="2.4" y="0.2"  yaw="0.5" sx="0.8" sy="0.4"/>
    <xacro:cylinder name="clutter_cyl_2" x="3.7" y="0.4"  r="0.25"/>
    <xacro:box      name="clutter_box_3" x="2.6" y="-1.4" yaw="0"   sx="0.5" sy="0.5"/>
    <xacro:cylinder name="clutter_cyl_3" x="3.8" y="-1.6" r="0.2"/>

  </world>
</sdf>
